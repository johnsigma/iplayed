{
  "compilerOptions": {
    /* Projeto e Saída */
    "target": "ES2022" /* Node 20 suporta ES2022 nativamente */,
    "module": "CommonJS" /* Padrão robusto para o ecossistema Express */,
    "removeComments": true /* Limpa o código final */,
    "baseUrl": ".",

    "paths": {
      "@shared/*": ["src/shared/*"] /* Alias para código compartilhado */,
      "@modules/*": ["src/modules/*"] /* Alias para módulos de domínio */
    },

    "types": ["node", "jest"] /* Tipos para Node e Jest (testes) */,

    "ignoreDeprecations": "6.0" /* Ignora avisos de depreciação do TypeScript 6.0 */,

    /* Rigor Técnico (Nível Profissional) */
    "strict": true /* Ativa todas as checagens de segurança */,
    "noImplicitAny": true /* Proíbe o uso de 'any' sem intenção */,
    "strictNullChecks": true /* Evita o erro 'cannot read property of null' */,
    "forceConsistentCasingInFileNames": true /* Evita erros entre Windows e Linux */,

    /* Interoperabilidade e Performance */
    "esModuleInterop": true /* Permite importar bibliotecas CommonJS como se fossem ES Modules */,
    "skipLibCheck": true /* Acelera a compilação pulando checagem de tipos de bibliotecas */,
    "resolveJsonModule": true /* Permite importar arquivos .json (útil para configs) */
  },
  "include": ["src/**/*", "tests/**/*"] /* Compila tudo dentro da src */,
  "exclude": ["node_modules"]
}
