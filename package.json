{
  "name": "iplayed",
  "version": "1.0.0",
  "description": "O **iPlayed** nasce da união de duas grandes paixões: o desenvolvimento de software e o universo dos jogos. Mais do que um simples rastreador, o projeto é um estudo prático de como construir uma aplicação robusta, escalável e tecnicamente rica, focada em quem realmente se importa com os detalhes de cada game jogado.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "db:setup": "tsx src/shared/infra/database/setup.ts",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest --runInBand",
    "test:watch": "jest --watchAll --runInBand",
    "test:coverage": "jest --coverage",
    "migrate:create": "node-pg-migrate create --migrations-dir src/shared/infra/database/migrations -j ts",
    "migrate:up": "dotenv -e .env.development -- node-pg-migrate up --migrations-dir src/shared/infra/database/migrations --tsx -j ts",
    "migrate:down": "dotenv -e .env.development -- node-pg-migrate down --migrations-dir src/shared/infra/database/migrations --tsx -j ts",
    "migrate:up:test": "dotenv -e .env.test -- node-pg-migrate up --migrations-dir src/shared/infra/database/migrations --tsx -j ts",
    "migrate:down:test": "dotenv -e .env.test -- node-pg-migrate down --migrations-dir src/shared/infra/database/migrations --tsx -j ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnsigma/iplayed.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/johnsigma/iplayed/issues"
  },
  "homepage": "https://github.com/johnsigma/iplayed#readme",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.2.0",
    "node-pg-migrate": "^7.9.1",
    "prettier": "^3.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "dotenv-expand": "^13.0.0",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "pg": "^8.17.2"
  }
}
